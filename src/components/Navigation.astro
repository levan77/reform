---
import { getLocale, useTranslations } from '../lib/i18n';

const locale = getLocale(Astro.request);
const t      = useTranslations(locale);

const links = [
  { label: t('nav.catalog'), href: '/#catalog' },
  { label: t('nav.process'), href: '/#process' },
  { label: t('nav.about'),   href: '/about'    },
  { label: t('nav.contact'), href: '/contact'  },
];

// `transparent` kept for API compatibility; the header is now always a solid
// dark bar so it's clearly visible on every background.
const { transparent = false } = Astro.props;
void transparent;

const otherLocale = locale === 'ka' ? 'en' : 'ka';
const currentPath = Astro.url.pathname + Astro.url.search;
const switchHref  = `/api/lang?to=${otherLocale}&from=${encodeURIComponent(currentPath)}`;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 bg-charcoal border-b border-white/10 shadow-[0_2px_18px_-6px_rgba(0,0,0,0.5)]"
>
  <nav
    class="max-w-screen-xl mx-auto px-6 md:px-10 h-20 flex items-center justify-between"
    aria-label="Primary navigation"
  >
    <!-- Logo -->
    <a href="/" class="flex items-baseline gap-2 group" aria-label="ReForma home">
      <span class="font-serif text-3xl text-warm-white tracking-tight leading-none">
        Re<em class="not-italic text-gold">Forma</em>
      </span>
      <span class="text-sm text-warm-white/45 hidden sm:inline">{t('nav.tbilisi')}</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-10" role="list">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="text-sm text-warm-white/70 hover:text-warm-white transition-colors duration-200"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4 md:gap-5">
      <!-- Language switcher -->
      <a
        href={switchHref}
        class="inline-flex items-center gap-1.5 px-3 py-2.5 text-sm text-warm-white/80
               hover:text-warm-white transition-colors duration-200 border border-white/25
               hover:border-white/50"
        aria-label={t('nav.switchToFull')}
        title={t('nav.switchToFull')}
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.1"/>
          <path d="M1.75 8h12.5M8 1.75c1.8 1.6 2.8 3.9 2.8 6.25S9.8 12.65 8 14.25c-1.8-1.6-2.8-3.9-2.8-6.25S6.2 3.35 8 1.75Z"
                stroke="currentColor" stroke-width="1.1"/>
        </svg>
        <span>{t('nav.switchTo')}</span>
      </a>

      <!-- CTA -->
      <a
        href="/#catalog"
        class="hidden md:inline-flex items-center gap-2 px-6 py-3 bg-gold text-charcoal text-sm font-medium
               hover:bg-gold-light transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-warm-white"
      >
        {t('nav.viewProperties')}
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-10 h-10 flex flex-col justify-center items-center gap-1.5"
        aria-label={t('nav.toggleMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-5 h-px bg-warm-white transition-transform duration-300" id="ham-top"></span>
        <span class="block w-5 h-px bg-warm-white transition-opacity duration-300"   id="ham-mid"></span>
        <span class="block w-5 h-px bg-warm-white transition-transform duration-300" id="ham-bot"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-charcoal border-t border-white/10"
    aria-hidden="true"
  >
    <ul class="flex flex-col px-6 py-4 gap-1" role="list">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="block py-3 text-label text-warm-white/75 hover:text-warm-white border-b border-white/10 last:border-0"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="/#catalog"
          class="block w-full text-center py-3 bg-gold text-charcoal text-label"
        >
          {t('nav.viewProperties')}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn    = document.getElementById('mobile-menu-btn')!;
  const menu   = document.getElementById('mobile-menu')!;
  const hamTop = document.getElementById('ham-top')!;
  const hamMid = document.getElementById('ham-mid')!;
  const hamBot = document.getElementById('ham-bot')!;

  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden',  String(!open));
    hamTop.style.transform = open ? 'translateY(5px) rotate(45deg)'  : '';
    hamMid.style.opacity   = open ? '0' : '1';
    hamBot.style.transform = open ? 'translateY(-5px) rotate(-45deg)' : '';
  });
</script>
