---
/**
 * BeforeAfterSlider — both images move
 *
 * Both the B&W and colour images translate in opposite directions as you drag,
 * creating a genuine parallax "both moving" wipe. clip-path handles the reveal;
 * a slight counter-translate on each image creates the depth illusion.
 */

import { getLocale, useTranslations } from '../lib/i18n';

interface Props {
  beforeSrc:        string;
  afterSrc:         string;
  alt?:             string;
  initialPosition?: number;
  aspectRatio?:     string;
  sliderId?:        string;
  grayscale?:       boolean;
}

const {
  beforeSrc,
  afterSrc,
  alt             = 'Property',
  initialPosition = 50,
  aspectRatio     = '4/3',
  sliderId        = `bas-${Math.random().toString(36).slice(2, 8)}`,
  grayscale       = true,
} = Astro.props;

const t          = useTranslations(getLocale(Astro.request));
const leftLabel  = grayscale ? t('slider.bw')    : 'Before';
const rightLabel = grayscale ? t('slider.color') : 'After';
---

<div
  class="bas-root relative w-full overflow-hidden select-none cursor-ew-resize bg-concrete"
  style={`aspect-ratio: ${aspectRatio};`}
  data-slider-id={sliderId}
  data-initial={initialPosition}
  role="img"
  aria-label={`${leftLabel} and ${rightLabel} comparison of ${alt}`}
  tabindex="0"
>
  <!-- LEFT image (B&W) — clipped to left of divider, slides rightward as pct grows -->
  <div class="bas-left-wrap absolute inset-0 pointer-events-none will-change-transform">
    <img
      src={beforeSrc}
      alt={`${leftLabel}: ${alt}`}
      class="absolute inset-0 w-full h-full object-cover"
      style={grayscale ? 'filter: grayscale(1) brightness(0.82) contrast(1.05); transform: scale(1.06);' : 'transform: scale(1.06);'}
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </div>

  <!-- RIGHT image (colour) — clipped to right of divider, slides leftward as pct grows -->
  <div class="bas-right-wrap absolute inset-0 pointer-events-none will-change-transform">
    <img
      src={afterSrc}
      alt={`${rightLabel}: ${alt}`}
      class="absolute inset-0 w-full h-full object-cover"
      style="transform: scale(1.06);"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </div>

  <!-- Divider line + handle -->
  <div
    class="bas-divider absolute inset-y-0 w-px bg-white shadow-[0_0_20px_rgba(255,255,255,0.6),0_0_4px_rgba(0,0,0,0.4)] pointer-events-none z-20"
    style={`left: ${initialPosition}%;`}
    aria-hidden="true"
  >
    <div class="
      bas-handle
      absolute top-1/2 left-1/2
      -translate-x-1/2 -translate-y-1/2
      w-12 h-12 rounded-full bg-white
      shadow-[0_4px_24px_rgba(0,0,0,0.35)]
      flex items-center justify-center z-20
    ">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M10 6L5 12L10 18"  stroke="#1a1a1a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14 6L19 12L14 18" stroke="#1a1a1a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <!-- Labels -->
  <span class="
    absolute bottom-4 left-4 z-10 pointer-events-none
    text-label text-white bg-black/55 backdrop-blur-sm px-3 py-1.5
  ">{leftLabel}</span>
  <span class="
    absolute bottom-4 right-4 z-10 pointer-events-none
    text-label text-white bg-black/55 backdrop-blur-sm px-3 py-1.5
  ">{rightLabel}</span>
</div>

<script>
  function clamp(v: number, lo: number, hi: number): number {
    return Math.min(hi, Math.max(lo, v));
  }

  function initSlider(root: HTMLElement): void {
    const leftWrap  = root.querySelector('.bas-left-wrap')  as HTMLElement | null;
    const rightWrap = root.querySelector('.bas-right-wrap') as HTMLElement | null;
    const divider   = root.querySelector('.bas-divider')    as HTMLElement | null;
    const handle    = root.querySelector('.bas-handle')     as HTMLElement | null;

    if (!leftWrap || !rightWrap || !divider || !handle) return;

    // How far each image slides (% of container width). Scaled images
    // absorb this shift without empty edges.
    const PARALLAX = 4; // percent of container

    let pct     = Number(root.dataset.initial ?? 50);
    let dragging = false;
    let rafId   = 0;

    function applyPosition(p: number): void {
      // clip-path reveals the respective half of each wrapper
      leftWrap.style.clipPath  = `inset(0 ${100 - p}% 0 0)`;
      rightWrap.style.clipPath = `inset(0 0 0 ${p}%)`;

      // Both images counter-translate — left shifts right as pct grows,
      // right shifts left, so both images "slide" toward the divider.
      const shift = (p - 50) * (PARALLAX / 50); // –PARALLAX … +PARALLAX
      leftWrap.style.transform  = `translateX(${shift}%)`;
      rightWrap.style.transform = `translateX(${-shift}%)`;

      divider.style.left = p + '%';
    }

    // Init
    applyPosition(pct);

    function onMove(clientX: number): void {
      const rect = root.getBoundingClientRect();
      pct = clamp(((clientX - rect.left) / rect.width) * 100, 1, 99);
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => applyPosition(pct));
    }

    // Mouse
    root.addEventListener('mousedown', (e: MouseEvent) => {
      dragging = true;
      handle.style.transform = 'translate(-50%,-50%) scale(1.12)';
      onMove(e.clientX);
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (dragging) onMove(e.clientX);
    });
    window.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      handle.style.transform = '';
    });

    // Touch
    root.addEventListener('touchstart', (e: TouchEvent) => {
      dragging = true;
      handle.style.transform = 'translate(-50%,-50%) scale(1.12)';
      onMove(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchmove', (e: TouchEvent) => {
      if (dragging) onMove(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      handle.style.transform = '';
    });

    // Keyboard
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const step = e.shiftKey ? 10 : 2;
      pct = clamp(pct + (e.key === 'ArrowRight' ? step : -step), 1, 99);
      applyPosition(pct);
    });
  }

  document.querySelectorAll('.bas-root').forEach(el => initSlider(el as HTMLElement));
</script>

<style>
  .bas-root:focus-visible {
    outline: 2px solid #b8965a;
    outline-offset: 2px;
  }
  .bas-left-wrap,
  .bas-right-wrap {
    transition: clip-path 0s, transform 0s; /* rAF handles timing */
  }
</style>
