---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import FloorPlanSwitcher from '../../components/FloorPlanSwitcher.astro';
import FinancialDashboard from '../../components/FinancialDashboard.astro';
import { getListing } from '../../lib/db';
import { getKV } from '../../lib/runtime';
import { getLocale, useTranslations, translateTag, localizeListing } from '../../lib/i18n';

const locale = getLocale(Astro.request);
const t      = useTranslations(locale);

const { slug } = Astro.params;
const raw      = slug ? await getListing(getKV(Astro.locals), slug) : undefined;
if (!raw) return Astro.redirect('/404');
const l = localizeListing(raw, locale);
---

<BaseLayout
  title={`${l.title} — ReForma`}
  description={`${l.size_sqm}${t('unit.sqm')} ${l.tags[0] ? translateTag(l.tags[0], locale) : ''} — ${l.district}`}
  ogImage={l.images.cover}
>
  <Navigation />

  <main class="pt-16">
    <section class="max-w-screen-xl mx-auto px-6 md:px-10 py-12 md:py-16">

      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-label text-charcoal/40">
          <li><a href="/" class="hover:text-charcoal transition-colors">{t('detail.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#catalog" class="hover:text-charcoal transition-colors">{t('detail.catalog')}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-charcoal/70" aria-current="page">{l.title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <div class="flex flex-wrap gap-1.5 mb-3">
            {l.tags.map(tag => (
              <span class="text-label text-charcoal/50 border border-hairline border-concrete-dark px-2.5 py-1">
                {translateTag(tag, locale)}
              </span>
            ))}
          </div>
          <h1 class="font-serif text-4xl md:text-6xl text-charcoal leading-tight">{l.title}</h1>
          <p class="text-charcoal/50 mt-2">{l.address}</p>
        </div>
        <div class="flex items-center gap-5 text-label text-charcoal/40 shrink-0 flex-wrap">
          <span>{l.size_sqm} {t('unit.sqm')}</span>
          <span class="w-px h-3 bg-concrete-dark"></span>
          <span>{t('detail.floor')} {l.floor} {t('detail.of')} {l.total_floors}</span>
          {l.year_built && <>
            <span class="w-px h-3 bg-concrete-dark"></span>
            <span>{t('detail.built')} {l.year_built}</span>
          </>}
        </div>
      </div>

      <!-- Main grid -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-8 lg:gap-12">

        <!-- Left column -->
        <div class="space-y-8">

          <!-- Before/After slider -->
          <div>
            <p class="text-label text-charcoal/40 mb-3">{t('detail.dragToCompare')}</p>
            <BeforeAfterSlider
              beforeSrc={l.images.before[0] ?? ''}
              afterSrc={l.images.after[0]  ?? ''}
              alt={l.title}
              initialPosition={45}
              aspectRatio="16/9"
            />
          </div>

          <!-- Description -->
          <div class="prose prose-sm max-w-none text-charcoal/70 leading-relaxed">
            <p>{l.description}</p>
          </div>

          <!-- Current state gallery -->
          {l.images.gallery && l.images.gallery.length > 0 && (
            <div class="gallery-section">
              <div class="flex items-baseline justify-between mb-4">
                <div>
                  <p class="text-label text-charcoal/40">{t('detail.currentState')}</p>
                  <p class="text-xs text-charcoal/30 mt-0.5">{t('detail.currentStateLabel')}</p>
                </div>
                <span class="text-label text-charcoal/30">{l.images.gallery.length} {locale === 'ka' ? 'ფოტო' : 'photos'}</span>
              </div>

              <!-- Responsive grid: 2 cols on mobile, 3 on md+ -->
              <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                {l.images.gallery.map((src, i) => (
                  <button
                    class="gallery-thumb group relative overflow-hidden bg-concrete aspect-[4/3] focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold"
                    data-src={src}
                    data-index={i}
                    aria-label={`${t('detail.currentState')} — photo ${i + 1}`}
                  >
                    <img
                      src={src}
                      alt={`${l.title} — current state ${i + 1}`}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                    <!-- Hover overlay -->
                    <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition-colors duration-300 flex items-center justify-center">
                      <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg"
                           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6"/>
                      </svg>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Floor plan switcher -->
          <div>
            <p class="text-label text-charcoal/40 mb-3">{t('detail.layout')}</p>
            <FloorPlanSwitcher
              existingPlanSrc={l.images.floor_plan_existing}
              optimizedPlanSrc={l.images.floor_plan_optimized}
              alt={l.title}
            />
          </div>

          <!-- Additional before/after pairs -->
          {l.images.before.length > 1 && (
            <div class="space-y-3">
              <p class="text-label text-charcoal/40">{t('detail.additionalViews')}</p>
              {l.images.before.slice(1).map((before, i) => (
                <BeforeAfterSlider
                  beforeSrc={before}
                  afterSrc={l.images.after[i + 1] ?? l.images.after[0] ?? ''}
                  alt={`${l.title} — ${t('detail.view')} ${i + 2}`}
                  aspectRatio="16/9"
                  sliderId={`bas-extra-${i}`}
                />
              ))}
            </div>
          )}
        </div>

        <!-- Right column — sticky financial dashboard -->
        <aside class="lg:sticky lg:top-24 self-start space-y-4">
          <FinancialDashboard financials={l.financials} size_sqm={l.size_sqm} />

          <a href={`mailto:hello@reforma.ge?subject=${encodeURIComponent(l.title)}`}
             class="block w-full text-center py-4 bg-charcoal text-warm-white text-label
                    hover:bg-charcoal-light transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold">
            {t('detail.enquire')}
          </a>
          <p class="text-label text-charcoal/30 text-center">
            {t('detail.renovationNote')}
          </p>
        </aside>
      </div>

    </section>
  </main>

  <!-- Lightbox overlay -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] bg-black/92 backdrop-blur-sm hidden items-center justify-center"
    aria-modal="true"
    role="dialog"
    aria-label="Photo lightbox"
  >
    <!-- Close -->
    <button id="lb-close"
      class="absolute top-5 right-5 w-11 h-11 flex items-center justify-center text-white/70 hover:text-white transition-colors"
      aria-label="Close lightbox">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Prev -->
    <button id="lb-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors"
      aria-label="Previous photo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
      </svg>
    </button>

    <!-- Image -->
    <img id="lb-img" src="" alt="" class="max-w-[90vw] max-h-[88vh] object-contain select-none" draggable="false" />

    <!-- Next -->
    <button id="lb-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors"
      aria-label="Next photo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
      </svg>
    </button>

    <!-- Counter -->
    <p id="lb-counter" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/50 text-sm tabular-nums"></p>
  </div>

  <script>
    const lb      = document.getElementById('lightbox')!;
    const lbImg   = document.getElementById('lb-img') as HTMLImageElement;
    const lbClose = document.getElementById('lb-close')!;
    const lbPrev  = document.getElementById('lb-prev')!;
    const lbNext  = document.getElementById('lb-next')!;
    const lbCount = document.getElementById('lb-counter')!;
    const thumbs  = [...document.querySelectorAll<HTMLButtonElement>('.gallery-thumb')];

    if (thumbs.length === 0) {
      lb.remove();
    } else {
      let current = 0;
      const srcs = thumbs.map(b => b.dataset.src ?? '');

      function show(i: number) {
        current = (i + srcs.length) % srcs.length;
        lbImg.src = srcs[current];
        lbCount.textContent = `${current + 1} / ${srcs.length}`;
      }

      function open(i: number) {
        show(i);
        lb.classList.remove('hidden');
        lb.classList.add('flex');
        document.body.style.overflow = 'hidden';
        lbClose.focus();
      }

      function close() {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.body.style.overflow = '';
      }

      thumbs.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
      lbClose.addEventListener('click', close);
      lbPrev.addEventListener('click', () => show(current - 1));
      lbNext.addEventListener('click', () => show(current + 1));

      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

      document.addEventListener('keydown', (e) => {
        if (lb.classList.contains('hidden')) return;
        if (e.key === 'Escape')     close();
        if (e.key === 'ArrowLeft')  show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    }
  </script>

  <!-- Footer -->
  <footer class="border-t border-hairline border-concrete-dark bg-warm-white mt-16">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10 flex flex-col md:flex-row items-start justify-between gap-6">
      <div>
        <p class="font-serif text-xl text-charcoal mb-1">Re<em class="not-italic text-gold">Forma</em></p>
        <p class="text-label text-charcoal/40">{t('footer.tagline')}</p>
      </div>
      <p class="text-label text-charcoal/30">© {new Date().getFullYear()} ReForma. {t('footer.rights')}</p>
    </div>
  </footer>
</BaseLayout>
