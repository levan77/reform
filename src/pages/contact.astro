---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { getLocale, useTranslations } from '../lib/i18n';

const locale = getLocale(Astro.request);
const t      = useTranslations(locale);

const sent  = Astro.url.searchParams.get('sent');
const error = Astro.url.searchParams.get('error');

const contactRows = [
  { label: t('contact.email'),   value: 'hello@reforma.ge' },
  { label: t('contact.phone'),   value: '+995 32 200 0000' },
  { label: t('contact.address'), value: t('contact.addressVal') },
  { label: t('contact.hours'),   value: t('contact.hoursVal') },
];
---

<BaseLayout title={t('contact.pageTitle')} description={t('contact.metaDesc')}>
  <Navigation />

  <main class="pt-16">
    <section class="max-w-screen-xl mx-auto px-6 md:px-10 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Left: info -->
      <div>
        <p class="text-label text-charcoal/40 mb-4">{t('contact.label')}</p>
        <h1 class="font-serif text-5xl text-charcoal leading-tight mb-6">{t('contact.title')}</h1>
        <p class="text-base text-charcoal/60 leading-relaxed max-w-md mb-10">{t('contact.intro')}</p>

        <div class="space-y-6">
          {contactRows.map(({ label, value }) => (
            <div>
              <p class="text-label text-charcoal/40 mb-0.5">{label}</p>
              <p class="text-charcoal">{value}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <div>
        {sent ? (
          <div class="bg-charcoal p-8 h-full flex flex-col justify-center">
            <p class="text-label text-gold mb-3">{t('contact.sentLabel')}</p>
            <h2 class="font-serif text-3xl text-warm-white mb-3">{t('contact.sentTitle')}</h2>
            <p class="text-warm-white/60 mb-6">{t('contact.sentBody')}</p>
            <a href="/contact" class="text-label text-gold hover:text-gold-light transition-colors">
              {t('contact.sentAgain')}
            </a>
          </div>
        ) : (
          <form method="POST" action="/api/contact" class="space-y-5">
            {error === 'missing' && (
              <div class="bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
                {t('contact.errMissing')}
              </div>
            )}

            <div>
              <label class="contact-label">{t('contact.fName')}</label>
              <input name="name" type="text" required placeholder={t('contact.fNamePh')} class="contact-input" />
            </div>
            <div>
              <label class="contact-label">{t('contact.fEmail')}</label>
              <input name="email" type="email" required placeholder={t('contact.fEmailPh')} class="contact-input" />
            </div>
            <div>
              <label class="contact-label">{t('contact.fSubject')}</label>
              <select name="subject" class="contact-input">
                <option value="listing">{t('contact.subListing')}</option>
                <option value="process">{t('contact.subProcess')}</option>
                <option value="sell">{t('contact.subSell')}</option>
                <option value="other">{t('contact.subOther')}</option>
              </select>
            </div>
            <div>
              <label class="contact-label">{t('contact.fMessage')}</label>
              <textarea name="message" rows="5" required
                        placeholder={t('contact.fMessagePh')}
                        class="contact-input resize-y"></textarea>
            </div>
            <button type="submit"
                    class="w-full py-3.5 bg-charcoal text-warm-white text-label
                           hover:bg-charcoal-light transition-colors">
              {t('contact.send')}
            </button>
          </form>
        )}
      </div>

    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-hairline border-concrete-dark bg-warm-white">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10 flex flex-col md:flex-row items-start justify-between gap-6">
      <div>
        <p class="font-serif text-xl text-charcoal mb-1">Re<em class="not-italic text-gold">Forma</em></p>
        <p class="text-label text-charcoal/40">{t('footer.tagline')}</p>
      </div>
      <p class="text-label text-charcoal/30">© {new Date().getFullYear()} ReForma. {t('footer.rights')}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .contact-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #666;
    margin-bottom: 0.4rem;
  }
  .contact-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 0.5px solid #d0cec9;
    background: #fafaf9;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: #1a1a1a;
    outline: none;
    transition: border-color 0.15s;
    display: block;
  }
  .contact-input:focus { border-color: #1a1a1a; }
</style>
