---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PropertyFilters from '../components/PropertyFilters.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { getListings } from '../lib/db';
import { getKV } from '../lib/runtime';
import { getLocale, useTranslations, localizeListing } from '../lib/i18n';

const locale = getLocale(Astro.request);
const t      = useTranslations(locale);

const all = await getListings(getKV(Astro.locals));
const listings = all
  .filter(l => new Date(l.published) <= new Date())
  .sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    return new Date(b.published).getTime() - new Date(a.published).getTime();
  })
  .map(l => localizeListing(l, locale));

const avgRoi = listings.length
  ? Math.round(listings.reduce((s, l) => {
      const g = l.financials.post_reno_market_value_gel - l.financials.asking_price_gel - l.financials.renovation_estimate_gel;
      return s + (g / (l.financials.asking_price_gel + l.financials.renovation_estimate_gel)) * 100;
    }, 0) / listings.length) + '%'
  : '—';

const districts = [...new Set(all.map(l => l.district))].length.toString();

const process = [
  { n: '01', title: t('process.s1t'), body: t('process.s1b') },
  { n: '02', title: t('process.s2t'), body: t('process.s2b') },
  { n: '03', title: t('process.s3t'), body: t('process.s3b') },
  { n: '04', title: t('process.s4t'), body: t('process.s4b') },
];
---

<BaseLayout>
  <Navigation transparent />

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative min-h-[90dvh] flex flex-col justify-end bg-charcoal overflow-hidden">
    <div class="absolute inset-0 opacity-20"
         style="background-image: repeating-linear-gradient(0deg,transparent,transparent 80px,rgba(255,255,255,.03) 80px,rgba(255,255,255,.03) 81px),repeating-linear-gradient(90deg,transparent,transparent 80px,rgba(255,255,255,.03) 80px,rgba(255,255,255,.03) 81px);"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/80 to-charcoal/40"></div>

    <div class="relative max-w-screen-xl mx-auto px-6 md:px-10 pb-16 md:pb-24 pt-32 space-y-6">
      <p class="text-label text-gold tracking-widest animate-fade-in" style="animation-delay:0.1s">
        {t('hero.eyebrow')}
      </p>
      <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-warm-white leading-[1.05] tracking-tight max-w-4xl animate-fade-in"
          style="animation-delay:0.2s">
        {t('hero.title1')}<br/>
        <em class="not-italic text-gold/90">{t('hero.title2')}</em>
      </h1>
      <p class="font-sans text-base md:text-lg text-warm-white/60 max-w-xl leading-relaxed animate-fade-in"
         style="animation-delay:0.35s">
        {t('hero.subtitle')}
      </p>
      <div class="flex flex-wrap items-center gap-4 animate-fade-in pt-2" style="animation-delay:0.5s">
        <a href="#catalog"
           class="inline-flex items-center gap-2 px-7 py-3.5 bg-gold text-charcoal text-label hover:bg-gold-light transition-colors">
          {t('hero.exploreCatalog')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/about" class="text-label text-warm-white/60 hover:text-warm-white transition-colors">
          {t('hero.howItWorks')}
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 right-10 hidden md:flex flex-col items-center gap-3">
      <span class="text-label text-warm-white/30 [writing-mode:vertical-rl]">{t('hero.scroll')}</span>
      <div class="w-px h-12 bg-warm-white/20 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full bg-warm-white/60" style="height:40%;animation:scrollBar 2s ease-in-out infinite;"></div>
      </div>
    </div>
  </section>

  <!-- ── Stats bar ─────────────────────────────────────────────────────── -->
  <div class="border-b border-hairline border-concrete-dark bg-warm-white">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10">
      <dl class="grid grid-cols-2 md:grid-cols-4 divide-x divide-hairline divide-concrete-dark">
        {[
          { label: t('stats.propertiesListed'), value: listings.length.toString() },
          { label: t('stats.avgRoi'),           value: avgRoi },
          { label: t('stats.avgRenovation'),    value: t('stats.avgRenovationVal') },
          { label: t('stats.districts'),        value: districts },
        ].map(stat => (
          <div class="py-5 px-5 first:pl-0 last:pr-0">
            <dt class="text-label text-charcoal/40 mb-1">{stat.label}</dt>
            <dd class="font-serif text-3xl text-charcoal">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- ── Catalog ───────────────────────────────────────────────────────── -->
  <section id="catalog" class="max-w-screen-xl mx-auto px-6 md:px-10 py-20 md:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <p class="text-label text-charcoal/40 mb-2">
          {t('catalog.label')} — {listings.length} {listings.length === 1 ? t('catalog.property') : t('catalog.properties')}
        </p>
        <h2 class="font-serif text-4xl md:text-5xl text-charcoal">{t('catalog.availableNow')}</h2>
      </div>
      <PropertyFilters />
    </div>

    <div id="properties-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {listings.map(l => <PropertyCard listing={l} locale={locale} />)}
    </div>

    {listings.length === 0 && (
      <p class="text-charcoal/40 text-center py-16">{t('catalog.none')}</p>
    )}
  </section>

  <!-- ── Process ───────────────────────────────────────────────────────── -->
  <section id="process" class="bg-concrete py-20 md:py-28">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10">
      <div class="max-w-2xl mb-14">
        <p class="text-label text-charcoal/40 mb-2">{t('process.label')}</p>
        <h2 class="font-serif text-4xl md:text-5xl text-charcoal">{t('process.title')}</h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-4 gap-px bg-concrete-dark">
        {process.map(s => (
          <li class="bg-warm-white p-8 space-y-3">
            <span class="font-mono text-label text-gold">{s.n}</span>
            <h3 class="font-serif text-2xl text-charcoal">{s.title}</h3>
            <p class="text-sm text-charcoal/60 leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Footer ────────────────────────────────────────────────────────── -->
  <footer class="border-t border-hairline border-concrete-dark bg-warm-white">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10 flex flex-col md:flex-row items-start justify-between gap-6">
      <div>
        <p class="font-serif text-xl text-charcoal mb-1">Re<em class="not-italic text-gold">Forma</em></p>
        <p class="text-label text-charcoal/40">{t('footer.tagline')}</p>
      </div>
      <nav class="flex gap-6">
        <a href="/about" class="text-label text-charcoal/40 hover:text-charcoal transition-colors">{t('nav.about')}</a>
        <a href="/contact" class="text-label text-charcoal/40 hover:text-charcoal transition-colors">{t('nav.contact')}</a>
      </nav>
      <p class="text-label text-charcoal/30">© {new Date().getFullYear()} ReForma. {t('footer.rights')}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  @keyframes scrollBar { 0%{transform:translateY(-100%)} 100%{transform:translateY(300%)} }
</style>
