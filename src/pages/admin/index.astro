---
import { getSessionFromRequest } from '../../lib/auth';
import { getSessionSecret } from '../../lib/runtime';

// If already logged in, go straight to dashboard
if (await getSessionFromRequest(Astro.request, getSessionSecret(Astro.locals))) {
  return Astro.redirect('/admin/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Admin Login — ReForma</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100dvh;
      background: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      width: 100%;
      max-width: 380px;
      background: #f5f4f2;
      padding: 2.5rem;
      margin: 1rem;
    }
    .logo {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.75rem;
      color: #1a1a1a;
      margin-bottom: 0.25rem;
    }
    .logo em { font-style: normal; color: #b8965a; }
    .subtitle {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #999;
      margin-bottom: 2rem;
    }
    label {
      display: block;
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #666;
      margin-bottom: 0.5rem;
    }
    input[type="password"] {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 0.5px solid #d0cec9;
      background: #fff;
      font-family: inherit;
      font-size: 1rem;
      color: #1a1a1a;
      outline: none;
      margin-bottom: 1.25rem;
    }
    input[type="password"]:focus { border-color: #1a1a1a; }
    button {
      width: 100%;
      padding: 0.875rem;
      background: #1a1a1a;
      color: #fafaf9;
      border: none;
      font-family: 'Inter', sans-serif;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover { background: #2e2e2e; }
    .error {
      background: #fee;
      border: 0.5px solid #fcc;
      padding: 0.625rem 0.875rem;
      font-size: 0.8125rem;
      color: #c00;
      margin-bottom: 1.25rem;
    }
    .hint {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #bbb;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Re<em>Forma</em></div>
    <div class="subtitle">Admin Access</div>

    {error && (
      <div class="error">Incorrect password. Please try again.</div>
    )}

    <form method="POST" action="/api/admin/login">
      <label for="password">Password</label>
      <input type="password" id="password" name="password"
             placeholder="Enter admin password" autofocus autocomplete="current-password" />
      <button type="submit">Sign In</button>
    </form>

    <p class="hint">Default password: <code>reforma2024</code></p>
  </div>
</body>
</html>
