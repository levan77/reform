---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { getLocale, useTranslations } from '../lib/i18n';

const locale = getLocale(Astro.request);
const t      = useTranslations(locale);

const values = [
  { n: '01', title: t('about.v1t'), body: t('about.v1b') },
  { n: '02', title: t('about.v2t'), body: t('about.v2b') },
  { n: '03', title: t('about.v3t'), body: t('about.v3b') },
];

const team = [
  { name: t('about.name1'), role: t('about.role1'), bio: t('about.bio1'),
    img: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&q=80&auto=format&fit=crop' },
  { name: t('about.name2'), role: t('about.role2'), bio: t('about.bio2'),
    img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&auto=format&fit=crop' },
  { name: t('about.name3'), role: t('about.role3'), bio: t('about.bio3'),
    img: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80&auto=format&fit=crop' },
];
---

<BaseLayout title={t('about.pageTitle')} description={t('about.metaDesc')}>
  <Navigation />

  <main class="pt-16">

    <!-- Hero -->
    <section class="max-w-screen-xl mx-auto px-6 md:px-10 pt-20 pb-16 grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <p class="text-label text-charcoal/40 mb-4">{t('about.label')}</p>
        <h1 class="font-serif text-5xl md:text-6xl text-charcoal leading-tight mb-6">
          {t('about.title1')}<br/><em class="not-italic text-gold">{t('about.title2')}</em>.
        </h1>
        <p class="text-base text-charcoal/60 leading-relaxed max-w-lg">{t('about.p1')}</p>
        <p class="text-base text-charcoal/60 leading-relaxed max-w-lg mt-4">{t('about.p2')}</p>
      </div>
      <div class="bg-concrete aspect-[4/3] overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=1200&q=80&auto=format&fit=crop"
          alt="Tbilisi architecture"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Values -->
    <section class="bg-charcoal py-20">
      <div class="max-w-screen-xl mx-auto px-6 md:px-10">
        <p class="text-label text-gold mb-10">{t('about.principles')}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-charcoal-light">
          {values.map(v => (
            <div class="bg-charcoal p-8">
              <span class="font-mono text-label text-gold">{v.n}</span>
              <h3 class="font-serif text-2xl text-warm-white mt-3 mb-3">{v.title}</h3>
              <p class="text-sm text-warm-white/50 leading-relaxed">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="max-w-screen-xl mx-auto px-6 md:px-10 py-20">
      <p class="text-label text-charcoal/40 mb-10">{t('about.team')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map(p => (
          <div>
            <div class="aspect-square overflow-hidden bg-concrete mb-4">
              <img src={p.img} alt={p.name}
                   class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
                   loading="lazy" />
            </div>
            <h3 class="font-serif text-xl text-charcoal">{p.name}</h3>
            <p class="text-label text-gold mt-1 mb-2">{p.role}</p>
            <p class="text-sm text-charcoal/60 leading-relaxed">{p.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-concrete py-16 border-t border-hairline border-concrete-dark">
      <div class="max-w-screen-xl mx-auto px-6 md:px-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="font-serif text-3xl text-charcoal">{t('about.ctaTitle')}</h2>
          <p class="text-charcoal/50 mt-1">{t('about.ctaText')}</p>
        </div>
        <a href="/#catalog"
           class="shrink-0 px-7 py-3.5 bg-charcoal text-warm-white text-label hover:bg-charcoal-light transition-colors">
          {t('about.ctaButton')}
        </a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-hairline border-concrete-dark bg-warm-white">
    <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-10 flex flex-col md:flex-row items-start justify-between gap-6">
      <div>
        <p class="font-serif text-xl text-charcoal mb-1">Re<em class="not-italic text-gold">Forma</em></p>
        <p class="text-label text-charcoal/40">{t('footer.tagline')}</p>
      </div>
      <p class="text-label text-charcoal/30">© {new Date().getFullYear()} ReForma. {t('footer.rights')}</p>
    </div>
  </footer>
</BaseLayout>
