---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Admin' } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} — ReForma Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-concrete min-h-dvh">

  <!-- Admin topbar -->
  <header class="bg-charcoal h-14 flex items-center justify-between px-6 sticky top-0 z-50">
    <div class="flex items-center gap-6">
      <a href="/admin/dashboard" class="font-serif text-lg text-warm-white">
        Re<em class="not-italic text-gold">Forma</em>
        <span class="text-label text-warm-white/30 ml-2">Admin</span>
      </a>
      <nav class="hidden sm:flex items-center gap-4">
        <a href="/admin/dashboard"
           class="text-label text-warm-white/50 hover:text-warm-white transition-colors">
          Dashboard
        </a>
        <a href="/admin/listings/new"
           class="text-label text-warm-white/50 hover:text-warm-white transition-colors">
          + New Listing
        </a>
        <a href="/" target="_blank"
           class="text-label text-warm-white/30 hover:text-warm-white/60 transition-colors">
          ↗ View Site
        </a>
      </nav>
    </div>
    <form method="POST" action="/api/admin/logout">
      <button type="submit"
              class="text-label text-warm-white/40 hover:text-warm-white/80 transition-colors">
        Sign out
      </button>
    </form>
  </header>

  <main class="max-w-screen-xl mx-auto px-4 sm:px-6 py-8">
    <slot />
  </main>

</body>
</html>
